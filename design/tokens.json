{
  "about": "RemoteFM1 iOS UI tokens. Colors are sRGB hex. 'hi' and 'lo' are the lit top edge and the drop shadow of keys and buttons; for a user-made theme derive them from 'key' (see SPEC.md, Themes).",
  "defaultTheme": "Tangerine",
  "themes": {
    "Tangerine": { "body": "#EE7A3C", "label": "#3A1606", "bed": "#874332", "key": "#924E3A", "hi": "#A9614B", "lo": "#64301F", "keyText": "#FBEDE3", "knob": "#1B1715", "mark": "#F4EDE6", "bezel": "#141210", "lcd": "#C9D6EA", "ink": "#13203A", "led": "#FFE6A8", "ledOff": "#6F6668" },
    "Midnight":  { "body": "#1E2230", "label": "#C9D2E6", "bed": "#12151D", "key": "#2B3244", "hi": "#3B4359", "lo": "#0A0C12", "keyText": "#E6ECF8", "knob": "#0A0B0F", "mark": "#6CF0C2", "bezel": "#05060A", "lcd": "#0D1F1A", "ink": "#7CF5C8", "led": "#6CF0C2", "ledOff": "#454B5C" },
    "Mint":      { "body": "#A8DCC8", "label": "#143329", "bed": "#2F5B52", "key": "#376A60", "hi": "#4A7F74", "lo": "#1E3F38", "keyText": "#EAF7F1", "knob": "#1A2421", "mark": "#F2FFF9", "bezel": "#121816", "lcd": "#E9F0D8", "ink": "#1E2A17", "led": "#FFF3B0", "ledOff": "#6E8580" },
    "Lilac":     { "body": "#C9AEE6", "label": "#2A1642", "bed": "#573B77", "key": "#634486", "hi": "#77589B", "lo": "#3B2655", "keyText": "#F6EFFC", "knob": "#1C1624", "mark": "#F7F0FF", "bezel": "#120E18", "lcd": "#D7E3F2", "ink": "#1A2236", "led": "#FFD6F0", "ledOff": "#8A7A9A" },
    "Cream":     { "body": "#EFE6D2", "label": "#2A231C", "bed": "#2A2520", "key": "#3A332C", "hi": "#4B433A", "lo": "#141110", "keyText": "#F3EBDC", "knob": "#E8622A", "mark": "#FFF4E8", "bezel": "#15120F", "lcd": "#F6C34A", "ink": "#2A1A05", "led": "#FF7A3D", "ledOff": "#6A6158" }
  },
  "roles": {
    "body": "faceplate (the whole screen background)",
    "label": "silkscreen text on the faceplate: knob labels, status chip, wordmark",
    "bed": "recessed wells: keybed, button well, OCT well",
    "key": "face of keys and buttons",
    "hi": "1pt inset highlight on the top edge of keys and buttons; also the face of a pressed/playhead key",
    "lo": "drop shadow under keys and buttons (0 3–4pt, no blur)",
    "keyText": "button legends",
    "knob": "knob body",
    "mark": "knob pointer",
    "bezel": "display frame",
    "lcd": "mock LCD background (design only; the app draws the firmware framebuffer)",
    "ink": "mock LCD text (design only)",
    "led": "lit key LED and lit button legend glow",
    "ledOff": "unlit LED slot"
  },
  "fixedColors": {
    "indicatorLed": "#FF3B2F",
    "playGlyph": "#4FE08A",
    "recGlyph": "#FF4436",
    "linkedDot": "#3BD47A",
    "sheet": { "background": "#17140F", "surface": "#211E19", "raised": "#2A251F", "line": "#2E2A23", "border": "#3A352D", "text": "#F3EBDC", "muted": "#A69C8A", "muted2": "#B5AB99", "accent": "#FF8A4C" }
  },
  "fonts": {
    "hardware": { "family": "Chakra Petch", "weight": 700, "use": "button legends, knob labels, OCT, wordmark, segmented labels on the faceplate", "tracking": "0.06–0.14em, uppercase" },
    "ui": { "family": "DM Sans", "weights": [400, 500, 600, 700], "use": "status chip, sheet, theme editor" },
    "title": { "family": "Unbounded", "weight": 700, "use": "sheet and editor titles only" },
    "mono": { "family": "DM Mono", "weight": 500, "use": "hex values in the theme editor; the mock LCD (design only)" },
    "license": "All four are SIL Open Font License (Google Fonts); bundle the TTFs."
  },
  "radii": {
    "displayBezel": "9% of display size",
    "lcdInner": "3.5% of display size",
    "button": "24% of button height",
    "buttonWell": "34% of button height + 6",
    "key": "min(42% of key width, 18)",
    "keybed": "8% of min(keybed width, height)",
    "pill": 999
  }
}
